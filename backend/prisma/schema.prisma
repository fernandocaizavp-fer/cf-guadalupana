generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  PROFESOR
  ESTUDIANTE
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String
  apellido  String
  correo    String     @unique
  cedula    String?  @unique
  password  String
  rol       Rol        @default(ESTUDIANTE)
  createdAt DateTime   @default(now())
  materiasComoProfesorPrincipal Materia[] @relation("ProfesorPrincipalMateria")

  matricula Matricula?
  materias  Materia[]
}

model Curso {
  id            Int         @id @default(autoincrement())
  ramaArtesanal String
  anioFormativo String
  fechaInicio   DateTime
  fechaFin      DateTime
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())


  materias   Materia[]
  matriculas Matricula[]
  observacionesAsistencia ObservacionAsistencia[]
}

model Materia {
  id         Int      @id @default(autoincrement())
  nombre     String
  cursoId    Int
  curso      Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  profesorId Int?
  profesor   Usuario? @relation(fields: [profesorId], references: [id], onDelete: SetNull)
  esSubmateria  Boolean @default(false)
  materiaParent String?
  profesorPrincipalId Int?
  profesorPrincipal   Usuario? @relation("ProfesorPrincipalMateria", fields: [profesorPrincipalId], references: [id])


  tareas Tarea[]
  supletorios Supletorio[]
  asistencias Asistencia[]
  notasDisciplina NotaDisciplina[]
}

model Matricula {
  id                      Int       @id @default(autoincrement())
  matriculaNo             String    @unique
  tomo                    String?
  pagina                  String?
  apellidos               String
  nombres                 String
  cedula                  String    @unique
  fechaNacimiento         DateTime?
  anioNacimiento          String?
  mesNacimiento           String?
  diaNacimiento           String?
  pais                    String?
  provincia               String?
  canton                  String?
  parroquia               String?
  ciudad                  String?
  nacionalidad            String?
  calle                   String?
  num                     String?
  transversal             String?
  telefono                String?
  correo                  String?
  cursoanterior           String?
  unidadeducativa         String?
  centroformacionanterior String?
  nombrepapa              String?
  profesionpapa           String?
  ocupacionpapa           String?
  nombremama              String?
  profesionmama           String?
  ocupacionmama           String?
  nombrerepresentante     String?
  ocupacionrepresentante  String?
  domiciliorepresentante  String?
  telefonorepresentante   String?
  correoestudiante        String?
  lugarfechamatricula     String?
  sexo                    String?
  nivelEstudio            String?
  tipoBachiller           String?
  conferidoPorA1          String?
  conferidoPorA2          String?
  especialidad            String?
  lugarfechacertificado   String?
  observacionAsistencia ObservacionAsistencia?
  createdAt               DateTime  @default(now())
  

  cursoId   Int
  curso     Curso   @relation(fields: [cursoId], references: [id])
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  notasTarea NotaTarea[]
  supletorios Supletorio[]
  asistenciaDetalles AsistenciaDetalle[]
  notasDisciplina NotaDisciplina[]
}

model Tarea {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  fecha       DateTime
  semestre    Int
  materiaId   Int
  materia     Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  notas NotaTarea[]
}

model Supletorio {
  id          Int       @id @default(autoincrement())
  valor       Float?
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, matriculaId])
}

model NotaTarea {
  id          Int       @id @default(autoincrement())
  valor       Float?
  observacion String?
  tareaId     Int
  tarea       Tarea     @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([tareaId, matriculaId])
}

model Asistencia {
  id          Int       @id @default(autoincrement())
  fecha       DateTime
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  detalles AsistenciaDetalle[]
}

model AsistenciaDetalle {
  id           Int        @id @default(autoincrement())
  presente     Boolean    @default(true)
  asistenciaId Int
  asistencia   Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  matriculaId  Int
  matricula    Matricula  @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([asistenciaId, matriculaId])
}

model ObservacionAsistencia {
  id          Int       @id @default(autoincrement())
  observacion String
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  cursoId     Int
  curso       Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
}

model Anuncio {
  id        Int      @id @default(autoincrement())
  titulo    String
  contenido String
  imagen    String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotaDisciplina {
  id          Int      @id @default(autoincrement())
  valor       Float
  semestre    Int      @default(1)
  matriculaId Int
  materiaId   Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  materia     Materia   @relation(fields: [materiaId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([matriculaId, materiaId, semestre])
}